rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is owner
    function isOwner() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
      );
    }

    // Function to check if user is admin or owner
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
      );
    }

    // Function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Function to check if user is NOT blacklisted
    function isNotBlacklisted() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlacklisted == false
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId && request.resource.data.role == 'player' && request.resource.data.isBlacklisted == false;
      allow update: if isAuth() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBlacklisted'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Pitches collection
    match /pitches/{pitchId} {
      allow read: if true;
      allow create: if isOwner() || (isAdmin() && request.resource.data.adminEmail == request.auth.token.email);
      allow update: if isOwner() || (isAdmin() && resource.data.adminEmail == request.auth.token.email && request.resource.data.adminEmail == request.auth.token.email);
      allow delete: if isOwner();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.userId || isAdmin() || (resource.data.bookingType == 'public' && resource.data.status == 'confirmed'));
      allow create: if isAuth() 
                    && isNotBlacklisted()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'locked_temporary'
                    && request.resource.data.totalAmount > 0
                    && request.resource.data.depositAmount >= 0
                    && request.resource.data.duration > 0;
      allow update: if isAuth() 
                    && isNotBlacklisted()
                    && (
                      isAdmin() || 
                      (
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptUrl', 'status']) &&
                        request.resource.data.status == 'pending_review' &&
                        resource.data.status == 'locked_temporary' &&
                        request.resource.data.receiptUrl is string &&
                        request.resource.data.receiptUrl.size() > 0
                      ) ||
                      (
                        request.resource.data.userId == request.auth.uid &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
                        (request.resource.data.status == 'rejected' || request.resource.data.status == 'cancelled') &&
                        (resource.data.status == 'locked_temporary' || resource.data.status == 'pending_review')
                      ) ||
                      // Allow players to join or leave public matches
                      (
                        resource.data.bookingType == 'public' &&
                        resource.data.status == 'confirmed' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedPlayers']) &&
                        (
                          // Join match: user adds themselves and respects max capacity
                          (
                            request.resource.data.joinedPlayers.size() <= resource.data.numPeople &&
                            request.resource.data.joinedPlayers.size() == resource.data.joinedPlayers.size() + 1
                          ) ||
                          // Leave match: user removes themselves
                          (
                            request.resource.data.joinedPlayers.size() == resource.data.joinedPlayers.size() - 1
                          )
                        )
                      )
                    );
      allow delete: if isAdmin();
    }

    match /day_schedules/{dayId} {
      allow read: if true;
      allow write: if isAuth() && isNotBlacklisted() && (
        isAdmin() || (
          // Non-admin writes: restricted to modifying 'slots' field and prevents schedule deletion/wiping
          ((resource == null && request.resource.data.keys().hasOnly(['slots'])) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots'])) &&
          (resource == null || request.resource.data.slots.size() >= resource.data.slots.size() - 4)
        )
      );
    }

    // Stats collection for public aggregation
    match /stats/{statId} {
      allow read: if true;
      allow update: if isAdmin();
      allow create: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && (request.auth.uid == request.resource.data.userId || request.resource.data.senderId == request.auth.uid || isAdmin() || isOwner());
      allow update: if isAuth() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Support Tickets collection
    match /support_tickets/{ticketId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.userId || request.auth.uid == ticketId || isAdmin());
      allow create, update: if isAuth() && (request.auth.uid == ticketId || isAdmin());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuth() && (request.auth.uid == ticketId || isAdmin());
        allow create: if isAuth() && (request.auth.uid == ticketId || isAdmin() || request.auth.uid == request.resource.data.senderId);
      }
    }

    // Settings collection (platform cities & configuration)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Communities collection
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isAuth() && isNotBlacklisted();
      allow update: if isAuth() && (resource.data.captainUid == request.auth.uid || isAdmin());
      allow delete: if isAuth() && (resource.data.captainUid == request.auth.uid || isOwner());
    }

    // Community Chat collection
    match /community_chat/{channelId}/messages/{messageId} {
      allow read: if true;
      allow create: if isAuth() && isNotBlacklisted() && request.resource.data.senderId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Platform Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leaderboard Data
    match /leaderboard/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // VAR Highlights collection
    match /var_highlights/{clipId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Goal of the Month contest collection
    match /goal_contest/{goalId} {
      allow read: if true;
      allow create: if isAuth() && isNotBlacklisted();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // Squad Arena Challenges collection
    match /squad_challenges/{challengeId} {
      allow read: if true;
      allow create: if isAuth() && isNotBlacklisted();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // Tournaments collection (admin-managed)
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Tournament Registrations collection
    match /tournament_registrations/{regId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBlacklisted();
      allow delete: if isAdmin();
    }
  }
}
