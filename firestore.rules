rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin or owner
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
      );
    }

    // Function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Function to check if user is NOT blacklisted
    function isNotBlacklisted() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlacklisted == false
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId && request.resource.data.role == 'player' && request.resource.data.isBlacklisted == false;
      allow update: if isAuth() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBlacklisted'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Pitches collection
    match /pitches/{pitchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.userId || isAdmin() || (resource.data.bookingType == 'public' && resource.data.status == 'confirmed'));
      allow create: if isAuth() 
                    && isNotBlacklisted()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'locked_temporary';
      allow update: if isAuth() 
                    && isNotBlacklisted()
                    && (
                      isAdmin() || 
                      (request.resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptUrl', 'status']) && request.resource.data.status == 'pending_review' && resource.data.status == 'locked_temporary') ||
                      // Allow players to join or leave public matches
                      (
                        resource.data.bookingType == 'public' &&
                        resource.data.status == 'confirmed' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedPlayers', 'joinedPlayerNames'])
                      )
                    );
      allow delete: if isAdmin();
    }

    match /day_schedules/{dayId} {
      allow read: if true;
      allow write: if isAuth() && isNotBlacklisted() && (
        isAdmin() || (
          // Only allowed to modify the slots field
          (resource == null || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots']))
        )
      );
    }

    // Stats collection for public aggregation
    match /stats/{statId} {
      allow read: if true;
      allow update: if isAuth() && (
        isAdmin() || 
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users', 'bookings', 'usersCount', 'totalBookings', 'totalRevenue']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['users']) || 
            (resource.data.users == null && request.resource.data.users == 1) ||
            (resource.data.users != null && request.resource.data.users == resource.data.users + 1)
          ) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bookings']) || 
            (resource.data.bookings == null && request.resource.data.bookings == 1) ||
            (resource.data.bookings != null && request.resource.data.bookings == resource.data.bookings + 1)
          )
        )
      );
      allow create: if isAdmin();
    }
  }
}
