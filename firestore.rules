rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is admin or owner
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
      );
    }

    // Function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Function to check if user is NOT blacklisted
    function isNotBlacklisted() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlacklisted == false
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId && request.resource.data.role == 'player' && request.resource.data.isBlacklisted == false;
      allow update: if isAuth() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBlacklisted'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Pitches collection
    match /pitches/{pitchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuth() 
                    && isNotBlacklisted()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'locked_temporary';
      allow update: if isAuth() 
                    && isNotBlacklisted()
                    && (isAdmin() || (request.resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiptUrl', 'status']) && request.resource.data.status == 'pending_review' && resource.data.status == 'locked_temporary'));
      allow delete: if isAdmin();
    }

    match /day_schedules/{dayId} {
      allow read: if true;
      allow write: if isAuth() && isNotBlacklisted() && (
        isAdmin() ||
        (
          resource == null ? (
            request.resource.data.slots.keys().all(k => request.resource.data.slots[k].userId == request.auth.uid)
          ) : (
            resource.data.slots.keys().all(k =>
              !(k in request.resource.data.slots) || request.resource.data.slots[k] == resource.data.slots[k] ? true : (
                resource.data.slots[k].userId == request.auth.uid ||
                (resource.data.slots[k].status == 'locked_temporary' && resource.data.slots[k].lockedUntil < request.time.toMillis())
              )
            ) &&
            request.resource.data.slots.keys().all(k =>
              !(k in resource.data.slots) || request.resource.data.slots[k] != resource.data.slots[k] ? (
                request.resource.data.slots[k].userId == request.auth.uid
              ) : true
            )
          )
        )
      );
    }

    // Stats collection for public aggregation
    match /stats/{statId} {
      allow read: if true;
      allow update: if isAuth() && (
        isAdmin() || 
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users', 'bookings', 'usersCount', 'totalBookings', 'totalRevenue']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().contains('users') || request.resource.data.users == (resource.data.users == null ? 1 : resource.data.users + 1)) &&
          (!request.resource.data.diff(resource.data).affectedKeys().contains('bookings') || request.resource.data.bookings == (resource.data.bookings == null ? 1 : resource.data.bookings + 1))
        )
      );
      allow create: if isAdmin();
    }

    // Academies collection
    match /academies/{academyId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
