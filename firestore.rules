rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is owner
    function isOwner() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
      );
    }

    // Function to check if user is admin or owner
    function isAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
      );
    }

    // Function to check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Function to check if user is NOT blacklisted
    function isNotBlacklisted() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlacklisted == false
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuth() && request.auth.uid == userId && request.resource.data.role == 'player' && request.resource.data.isBlacklisted == false;
      allow update: if isAuth() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBlacklisted', 'isVip', 'vipExpiry'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Usernames uniqueness reservation collection
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // Pitches collection
    match /pitches/{pitchId} {
      allow read: if true;
      allow create: if isOwner() || (isAdmin() && request.resource.data.adminEmail == request.auth.token.email);
      allow update: if isOwner() || (isAdmin() && resource.data.adminEmail == request.auth.token.email && request.resource.data.adminEmail == request.auth.token.email);
      allow delete: if isOwner();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if (resource.data.bookingType == 'public' && resource.data.status == 'confirmed') || (isAuth() && (request.auth.uid == resource.data.userId || isAdmin()));
      allow create: if isAuth() 
                    && isNotBlacklisted()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() 
                    && isNotBlacklisted()
                    && (
                      isAdmin() || 
                      request.resource.data.userId == request.auth.uid ||
                      (
                        resource.data.bookingType == 'public' &&
                        resource.data.status == 'confirmed' &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedPlayers'])
                      )
                    );
      allow delete: if isAdmin();
    }

    match /day_schedules/{dayId} {
      allow read: if true;
      allow write: if isAuth() && isNotBlacklisted();
    }

    // Stats collection for public aggregation
    match /stats/{statId} {
      allow read: if true;
      allow update: if isAdmin();
      allow create: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Support Tickets collection
    match /support_tickets/{ticketId} {
      allow read: if isAuth() && (request.auth.uid == resource.data.userId || request.auth.uid == ticketId || isAdmin());
      allow create, update: if isAuth() && (request.auth.uid == ticketId || isAdmin());
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuth() && (request.auth.uid == ticketId || isAdmin());
        allow create: if isAuth() && (request.auth.uid == ticketId || isAdmin() || request.auth.uid == request.resource.data.senderId);
      }
    }

    // Settings collection (platform cities & configuration)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Communities collection
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isAuth() && isNotBlacklisted();
      allow update: if isAuth() && isNotBlacklisted() && (
        resource.data.captainUid == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'membersCount'])
      );
      allow delete: if isAuth() && (resource.data.captainUid == request.auth.uid || isOwner());
    }

    // Community Chat collection
    match /community_chat/{channelId}/messages/{messageId} {
      allow read: if true;
      allow create: if isAuth() && isNotBlacklisted() && request.resource.data.senderId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Platform Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leaderboard Data
    match /leaderboard/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // VAR Highlights collection
    match /var_highlights/{clipId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Goal of the Month contest collection
    match /goal_contest/{goalId} {
      allow read: if true;
      allow create: if isAuth() && isNotBlacklisted();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // Squad Arena Challenges collection
    match /squad_challenges/{challengeId} {
      allow read: if true;
      allow create: if isAuth() && isNotBlacklisted();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // Tournaments collection (admin-managed)
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Tournament Registrations collection
    match /tournament_registrations/{regId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBlacklisted();
      allow delete: if isAdmin();
    }

    // AI Usage Logs collection
    match /aiLogs/{logId} {
      allow read: if isOwner();
      allow create: if true;
    }

    // System collection (Season Ceremony settings, system configuration)
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
